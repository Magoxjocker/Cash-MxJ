<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/cash_background" android:padding="16dp">

    <Button android:id="@+id/btnVolverCompartidas" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="← Volver" android:textAllCaps="false" android:layout_marginBottom="12dp" android:backgroundTint="@color/cash_secondary_light" android:textColor="@color/cash_primary_dark" android:minHeight="50dp" android:textSize="15sp" android:fontFamily="sans-medium"/>

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Compras compartidas" android:textSize="24sp" android:textStyle="bold" android:textColor="@color/cash_text_primary" android:layout_marginBottom="8dp" android:fontFamily="sans-medium"/>

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Consulta tus compras, participantes y deudas pendientes." android:textSize="14sp" android:textColor="@color/cash_text_secondary" android:layout_marginBottom="16dp"/>

    <Button android:id="@+id/btnNuevaCompartida" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="+ Nueva compra compartida" android:textAllCaps="false" android:backgroundTint="@color/cash_primary" android:textColor="@color/cash_white" android:minHeight="50dp" android:textSize="15sp" android:fontFamily="sans-medium"/>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="12dp">

        <LinearLayout android:id="@+id/contenedorHistorialCompartidas" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>

    </ScrollView>

</LinearLayout>
