<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/cash_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- BOTÓN VOLVER -->
        <TextView
            android:id="@+id/btnVolver"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← Volver"
            android:textColor="@color/cash_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- TÍTULO -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Mis cuentas"
            android:textColor="@color/cash_primary_dark"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Administra tus fuentes de dinero"
            android:textColor="@color/cash_text_secondary"
            android:textSize="15sp" />

        <!-- SALDO TOTAL -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@color/cash_primary"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Saldo total"
                android:textColor="@color/cash_white"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvSaldoCuentas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="$0"
                android:textColor="@color/cash_white"
                android:textSize="34sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- TÍTULO LISTADO -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Tus cuentas"
            android:textColor="@color/cash_text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- AQUÍ SE MOSTRARÁN LAS CUENTAS DE SQLITE -->
        <LinearLayout
            android:id="@+id/contenedorCuentas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical" />

        <!-- ESTADO CUANDO NO EXISTEN CUENTAS -->
        <LinearLayout
            android:id="@+id/contenedorSinCuentas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💰"
                android:textSize="34sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Aún no tienes cuentas"
                android:textColor="@color/cash_text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="Agrega tu primera cuenta para comenzar a registrar tus movimientos."
                android:textColor="@color/cash_text_secondary"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- BOTÓN NUEVA CUENTA -->
        <Button
            android:id="@+id/btnNuevaCuenta"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"
            android:backgroundTint="@color/cash_secondary"
            android:text="+ Nueva cuenta"
            android:textAllCaps="false"
            android:textColor="@color/cash_white"
            android:textSize="17sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>