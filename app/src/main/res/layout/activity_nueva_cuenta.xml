<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/cash_background">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">

        <!-- VOLVER -->
        <TextView android:id="@+id/btnVolver" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="← Volver" android:textColor="@color/cash_primary" android:textSize="16sp" android:textStyle="bold" android:fontFamily="sans-medium" android:contentDescription="← Volver" android:clickable="true" android:focusable="true"/>

        <!-- TÍTULO -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="Nueva cuenta" android:textColor="@color/cash_primary_dark" android:textSize="30sp" android:textStyle="bold" android:fontFamily="sans-medium"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Registra una nueva fuente de dinero" android:textColor="@color/cash_text_secondary" android:textSize="15sp"/>

        <!-- NOMBRE -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:text="Nombre de la cuenta" android:textColor="@color/cash_text_primary" android:textSize="15sp" android:textStyle="bold" android:fontFamily="sans-medium"/>

        <EditText android:id="@+id/etNombreCuenta" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="8dp" android:hint="Ej: Efectivo" android:inputType="textCapSentences" android:padding="14dp" android:singleLine="true" android:background="@drawable/bg_cash_field" android:textColor="@color/cash_text_primary" android:textColorHint="@color/cash_text_secondary" android:textSize="16sp" android:minHeight="52dp"/>

        <!-- TIPO -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="Tipo de cuenta" android:textColor="@color/cash_text_primary" android:textSize="15sp" android:textStyle="bold" android:fontFamily="sans-medium"/>

        <Spinner android:id="@+id/spTipoCuenta" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="8dp" android:background="@drawable/bg_cash_field" android:paddingStart="12dp" android:paddingEnd="12dp" android:minHeight="52dp"/>

        <!-- SALDO -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="Saldo inicial" android:textColor="@color/cash_text_primary" android:textSize="15sp" android:textStyle="bold" android:fontFamily="sans-medium"/>

        <EditText android:id="@+id/etSaldoInicial" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="8dp" android:hint="$ 0" android:inputType="number" android:padding="14dp" android:singleLine="true" android:background="@drawable/bg_cash_field" android:textColor="@color/cash_text_primary" android:textColorHint="@color/cash_text_secondary" android:textSize="16sp" android:minHeight="52dp"/>

        <!-- DESCRIPCIÓN -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="Descripción (opcional)" android:textColor="@color/cash_text_primary" android:textSize="15sp" android:textStyle="bold" android:fontFamily="sans-medium"/>

        <EditText android:id="@+id/etDescripcionCuenta" android:layout_width="match_parent" android:layout_height="90dp" android:layout_marginTop="8dp" android:gravity="top" android:hint="Ej: Dinero disponible para gastos diarios" android:inputType="textCapSentences|textMultiLine" android:padding="14dp" android:background="@drawable/bg_cash_field" android:textColor="@color/cash_text_primary" android:textColorHint="@color/cash_text_secondary" android:textSize="16sp" android:minHeight="52dp"/>

        <!-- GUARDAR -->
        <Button android:id="@+id/btnGuardarCuenta" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="28dp" android:backgroundTint="@color/cash_primary" android:text="Guardar cuenta" android:textAllCaps="false" android:textColor="@color/cash_white" android:textSize="15sp" android:textStyle="bold" android:minHeight="50dp" android:fontFamily="sans-medium"/>

    </LinearLayout>

</ScrollView>
