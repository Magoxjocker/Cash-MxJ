
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cash_background"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnVolverMapa"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="50dp"
            android:backgroundTint="@color/cash_secondary_light"
            android:text="← Volver"
            android:textAllCaps="false"
            android:textColor="@color/cash_primary_dark"
            android:textSize="15sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="Mis lugares"
            android:textColor="@color/cash_primary_dark"
            android:textSize="24sp"
            android:textStyle="bold" />

    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp"
        android:text="Mantén presionado el mapa para agregar un lugar. Toca un marcador para editarlo o eliminarlo."
        android:textColor="@color/cash_text_secondary"
        android:textSize="14sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_mapa_panel"
        android:padding="3dp">

        <org.maplibre.android.maps.MapView
            android:id="@+id/mapaLugares"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />



        <ImageButton
            android:id="@+id/btnMiUbicacion"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="top|end"
            android:layout_margin="12dp"
            android:background="@drawable/bg_boton_ubicacion"
            android:contentDescription="Encontrar mi ubicación"
            android:src="@android:drawable/ic_menu_mylocation"
            android:scaleType="centerInside"
            android:padding="14dp"
            android:elevation="20dp"
            android:translationZ="20dp"
            android:visibility="visible"
            android:clickable="true"
            android:focusable="true" />



    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_mapa_panel"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvCantidadLugares"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="0 lugares guardados"
            android:textColor="@color/cash_primary_dark"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Cada ubicación se guarda en tu dispositivo."
            android:textColor="@color/cash_text_secondary"
            android:textSize="13sp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:maxHeight="190dp">

            <LinearLayout
                android:id="@+id/contenedorLugares"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </ScrollView>

    </LinearLayout>

</LinearLayout>
