<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/cash_background">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center" android:padding="28dp" android:orientation="vertical" android:gravity="center_horizontal">
<ImageView android:layout_width="150dp" android:layout_height="150dp" android:src="@drawable/ilustracion_cash_gato" android:contentDescription="Gato con moneda de Cash MxJ" android:layout_marginBottom="12dp" />
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Cash MxJ" android:textSize="32sp" android:textStyle="bold" android:textColor="@color/cash_primary" />
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tu dinero, bajo control 🐾" android:textSize="16sp" android:textColor="@color/cash_text_secondary" android:layout_marginBottom="28dp" />
<EditText android:id="@+id/registroCorreo" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginBottom="12dp" android:padding="14dp" android:background="@drawable/bg_cash_field" android:hint="Correo electrónico" android:inputType="textEmailAddress" android:singleLine="true" /><EditText android:id="@+id/registroClave" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginBottom="12dp" android:padding="14dp" android:background="@drawable/bg_cash_field" android:hint="Contraseña (mínimo 8 caracteres)" android:inputType="textPassword" android:singleLine="true" /><EditText android:id="@+id/registroConfirmar" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginBottom="12dp" android:padding="14dp" android:background="@drawable/bg_cash_field" android:hint="Repetir contraseña" android:inputType="textPassword" android:singleLine="true" /><Button android:id="@+id/btnRegistrar" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:layout_marginTop="10dp" android:text="Registrarme" />
</LinearLayout></ScrollView>