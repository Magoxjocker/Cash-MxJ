<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/cash_background" android:fillViewport="true">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">

        <TextView android:id="@+id/btnVolverContactos" android:layout_width="wrap_content" android:layout_height="wrap_content" android:padding="10dp" android:text="← Volver" android:textColor="@color/cash_primary" android:textSize="16sp" android:clickable="true" android:focusable="true" android:contentDescription="← Volver"/>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="Mis contactos" android:textColor="@color/cash_text_primary" android:textSize="28sp" android:textStyle="bold" android:fontFamily="sans-medium"/>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Administra las personas con quienes podrás compartir compras y gastos." android:textColor="#666666" android:textSize="14sp"/>

        <Button android:id="@+id/btnNuevoContacto" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:backgroundTint="@color/cash_primary" android:text="+ Agregar contacto" android:textColor="@color/cash_white" android:textAllCaps="false" android:textSize="15sp" android:minHeight="50dp" android:fontFamily="sans-medium"/>

        <TextView android:id="@+id/tvSinContactos" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="32dp" android:gravity="center" android:padding="24dp" android:text="Todavía no tienes contactos registrados." android:textColor="#666666" android:textSize="16sp"/>

        <LinearLayout android:id="@+id/contenedorContactos" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:orientation="vertical"/>

    </LinearLayout>

</ScrollView>
