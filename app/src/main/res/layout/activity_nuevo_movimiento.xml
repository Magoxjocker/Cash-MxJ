<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/cash_background">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">

        <!-- VOLVER -->
        <TextView android:id="@+id/btnVolverNuevoMovimiento" android:layout_width="wrap_content" android:layout_height="48dp" android:minWidth="100dp" android:gravity="center_vertical" android:paddingEnd="16dp" android:text="← Volver" android:textColor="@color/cash_primary" android:textSize="16sp" android:textStyle="bold" android:clickable="true" android:focusable="true" android:fontFamily="sans-medium" android:contentDescription="← Volver"/>

        <!-- TITULO -->
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="Nuevo movimiento" android:textColor="@color/cash_primary_dark" android:textSize="28sp" android:textStyle="bold" android:fontFamily="sans-medium"/>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Registra tus ingresos y gastos" android:textColor="@color/cash_text_secondary" android:textSize="15sp"/>

        <!-- TIPO -->
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:text="Tipo de movimiento" android:textColor="@color/cash_text_primary" android:textSize="16sp" android:textStyle="bold" android:fontFamily="sans-medium"/>

        <RadioGroup android:id="@+id/rgTipoMovimiento" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">

            <RadioButton android:id="@+id/rbIngreso" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:buttonTint="@color/cash_primary" android:checked="true" android:text="Ingreso" android:textColor="@color/cash_text_primary" android:textSize="16sp"/>

            <RadioButton android:id="@+id/rbGasto" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:buttonTint="@color/cash_primary" android:text="Gasto" android:textColor="@color/cash_text_primary" android:textSize="16sp"/>

        </RadioGroup>

        <!-- CUENTA -->
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="Cuenta" android:textColor="@color/cash_text_primary" android:textSize="16sp" android:textStyle="bold" android:fontFamily="sans-medium"/>

        <Spinner android:id="@+id/spCuentaMovimiento" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="8dp" android:background="@drawable/bg_cash_field" android:paddingStart="12dp" android:paddingEnd="12dp" android:minHeight="52dp"/>

        <!-- MONTO -->
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="Monto (CLP)" android:textColor="@color/cash_text_primary" android:textSize="16sp" android:textStyle="bold" android:fontFamily="sans-medium"/>

        <EditText android:id="@+id/etMontoMovimiento" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="8dp" android:background="@drawable/bg_cash_field" android:hint="Ej.: 25000" android:inputType="number" android:maxLines="1" android:paddingStart="16dp" android:paddingEnd="16dp" android:textColor="@color/cash_text_primary" android:textColorHint="@color/cash_text_secondary" android:textSize="16sp" android:padding="14dp" android:minHeight="52dp"/>

        <!-- CATEGORIA -->
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="Categoría" android:textColor="@color/cash_text_primary" android:textSize="16sp" android:textStyle="bold" android:fontFamily="sans-medium"/>

        <Spinner android:id="@+id/spCategoriaMovimiento" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="8dp" android:background="@drawable/bg_cash_field" android:paddingStart="12dp" android:paddingEnd="12dp" android:minHeight="52dp"/>

        <!-- DESCRIPCION -->
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="Descripción (opcional)" android:textColor="@color/cash_text_primary" android:textSize="16sp" android:textStyle="bold" android:fontFamily="sans-medium"/>

        <EditText android:id="@+id/etDescripcionMovimiento" android:layout_width="match_parent" android:layout_height="96dp" android:layout_marginTop="8dp" android:background="@drawable/bg_cash_field" android:gravity="top" android:hint="Agrega un detalle del movimiento" android:inputType="textCapSentences|textMultiLine" android:padding="14dp" android:textColor="@color/cash_text_primary" android:textColorHint="@color/cash_text_secondary" android:textSize="16sp" android:minHeight="52dp"/>

        <!-- GUARDAR -->
        <Button android:id="@+id/btnGuardarMovimiento" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="32dp" android:layout_marginBottom="24dp" android:backgroundTint="@color/cash_primary" android:text="Guardar movimiento" android:textAllCaps="false" android:textColor="@color/cash_white" android:textSize="15sp" android:textStyle="bold" android:minHeight="50dp" android:fontFamily="sans-medium"/>

    </LinearLayout>

</ScrollView>
